<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="11.0.0" />
    <PackageVersion Include="SystemTextJson.JsonDiffPatch" Version="2.0.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="23.1.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="23.1.0" />
    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <!-- Input validation -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <!-- Swagger / OpenAPI -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <!-- Asp.Versioning.OpenApi 10.x requires Microsoft.OpenApi 2.x; ASP.NET OpenAPI 11 requires 3.x. -->
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.2.0" />
    <!-- OAuth -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Duende.AccessTokenManagement" Version="4.3.0" />
    <!-- Entity Framework -->
    <!-- Keep EF Core, the Npgsql provider, and naming conventions on matching major versions. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="11.0.0" />
    <!-- Tests and testing -->
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.3" />
    <PackageVersion Include="Reqnroll" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.xUnit.v3" Version="3.3.4" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="7.1.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageVersion Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <!-- Quality -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
  </ItemGroup>
</Project>